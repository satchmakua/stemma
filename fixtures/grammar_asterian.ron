// Asterian grammar — the M17 acceptance fixture.
//
// The REFERENCE ASTERIAN INVENTORY VERBATIM (the same 15 phonemes and initial-stress
// prosody as every other Asterian fixture) plus a `syntax:` profile: DESIGN §7.4's
// parameters, as data.
//
//   stemma grammar fixtures/grammar_asterian.ron
//
// THE POINT (ROADMAP M17): a language should be able to say how it builds a clause,
// and Stemma should be able to say whether that combination is a common one — WITHOUT
// refusing it. This profile is deliberately DISHARMONIC in one place, so the sketch
// has something true and interesting to report about it.
//
// Asterian is verb-final and head-final almost everywhere: postpositions, possessor
// before possessed, relative clauses before the noun they modify. The one exception
// is its adjectives, which follow the noun. That is not a mistake in the fixture and
// it is not rare in the world either — adjective order is the classic noun-phrase
// parameter that goes its own way, which is exactly why `headedness()` does not count
// it.
//
// The deliberate oddity is ALIGNMENT + FREE-ish morphology interacting with the case
// system: Asterian is ergative-absolutive, which is uncommon among verb-final
// languages but far from unknown (Basque, Georgian, much of Australia). Stemma has no
// warning for that pairing, and should not invent one — which is itself the lesson:
// only correlations this program can state honestly are reported.
//
// To see the harmony machinery actually fire, flip `adpositions` to `prepositions`.
// The sketch will tell you that object-verb order usually goes with postpositions,
// that the combination is attested but uncommon, and that it is not refusing it.
(
    id: "asterian_grammar",
    name: "Asterian (grammar)",
    lineage_depth_years: 0,
    seed: 42,

    phonemes: [
        // --- Stops ---
        (id: "ph_p", ipa: "p", kind: consonant, frequency_weight: 30,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "+labial", "-coronal", "-dorsal", "-round"]),
        (id: "ph_t", ipa: "t", kind: consonant, frequency_weight: 50,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "+coronal", "-dorsal"]),
        (id: "ph_k", ipa: "k", kind: consonant, frequency_weight: 45,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "+back", "-round"]),

        // --- Nasals ---
        (id: "ph_m", ipa: "m", kind: consonant, frequency_weight: 35,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "-continuant", "+nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "-dorsal", "-round"]),
        (id: "ph_n", ipa: "n", kind: consonant, frequency_weight: 40,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "-continuant", "+nasal", "-lateral", "-trill", "+voice", "-labial", "+coronal", "-dorsal"]),

        // --- Fricative ---
        (id: "ph_s", ipa: "s", kind: consonant, frequency_weight: 35,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "+continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "+coronal", "-dorsal"]),

        // --- Liquids ---
        (id: "ph_l", ipa: "l", kind: consonant, frequency_weight: 30,
         features: ["-syllabic", "+consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "+lateral", "-trill", "+voice", "-labial", "+coronal", "-dorsal"]),
        (id: "ph_r", ipa: "r", kind: consonant, frequency_weight: 25,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "+continuant", "-nasal", "-lateral", "+trill", "+voice", "-labial", "+coronal", "-dorsal"]),

        // --- Glides ---
        (id: "ph_w", ipa: "w", kind: consonant, frequency_weight: 20,
         features: ["-syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "+high", "-low", "+back", "+round"]),
        (id: "ph_j", ipa: "j", romanization: "y", kind: consonant, frequency_weight: 10,
         features: ["-syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "-back", "-round"]),

        // --- Vowels ---
        (id: "ph_a", ipa: "a", kind: vowel, frequency_weight: 60,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "-high", "+low", "+back", "-round"]),
        (id: "ph_e", ipa: "e", kind: vowel, frequency_weight: 35,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "-high", "-low", "-back", "-round"]),
        (id: "ph_i", ipa: "i", kind: vowel, frequency_weight: 40,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "-back", "-round"]),
        (id: "ph_o", ipa: "o", kind: vowel, frequency_weight: 30,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "-high", "-low", "+back", "+round"]),
        (id: "ph_u", ipa: "u", kind: vowel, frequency_weight: 35,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "+high", "-low", "+back", "+round"]),
    ],

    phonotactics: (
        templates: [
            (pattern: "CV",  weight: 45),
            (pattern: "CVC", weight: 35),
            (pattern: "V",   weight: 12),
            (pattern: "VC",  weight: 8),
        ],
        syllables_per_root: [
            (count: 1, weight: 25),
            (count: 2, weight: 55),
            (count: 3, weight: 20),
        ],
    ),

    prosody: (stress: fixed(from: left, offset: 0)),

    // DESIGN §7.4's parameters. Every one is a claim about the language, and every
    // one may be left out — an omitted parameter prints as `—` in the sketch rather
    // than silently defaulting to whatever is commonest.
    //
    // `head_directionality` is NOT here, deliberately: it is a summary of the orders
    // below, so storing it would be a second source of truth that disagrees with the
    // first the moment somebody edits one field. `stemma grammar` derives it.
    syntax: (
        note: "Rigidly verb-final, with a rich case system and an evidential contrast the priests are said to have introduced.",

        word_order: sov,
        adpositions: postpositions,
        genitive: genitive_noun,
        // The one head-initial thing in the language. Adjective order does not track
        // headedness cross-linguistically, so this is ordinary rather than odd.
        adjective: noun_adjective,

        alignment: ergative_absolutive,
        relative_clause: prenominal,

        negation: affix,
        question: particle,
        pro_drop: yes,
        evidentiality: two_way,
        switch_reference: marked,
    ),

    notes: [
        "The M17 acceptance fixture: `stemma grammar` prints §7.4's parameters and reports the harmony of the combination.",
        "Flip `adpositions` to `prepositions` to see a disharmony warning fire; the language still validates.",
    ],
)
