// Asterian as a head-initial language — the other half of the M18 acceptance pair.
//
// The SAME 15 phonemes, the SAME phonotactics and the SAME seed as
// `grammar_asterian.ron`, so `new-lexicon` coins THE SAME WORDS for both. Everything
// that differs between the sentences they produce is the syntax profile.
//
//   stemma new-lexicon fixtures/grammar_asterian.ron     --out out/sov.ron
//   stemma new-lexicon fixtures/grammar_svo_asterian.ron --out out/svo.ron
//   stemma say out/sov.ron 'SEE(KING:BIG, STAR/PRIEST)'
//   stemma say out/svo.ron 'SEE(KING:BIG, STAR/PRIEST)'
//
// Four parameters are flipped, and each one moves something visible:
//
//   word_order      sov              -> svo              the verb moves to the middle
//   adjective       noun_adjective   -> adjective_noun   the adjective changes side
//   genitive        genitive_noun    -> noun_genitive    so does the possessor
//   alignment       ergative         -> nominative       and the case marking inverts
//
// The alignment flip is the sharpest of the four, because it is not a reordering: an
// ergative language marks the agent of a TRANSITIVE clause and leaves an intransitive
// argument bare-absolutive, and a nominative language does the reverse. Run
// `SEE(KING)` through both and the same word takes two different suffixes for a
// reason that is about grammar rather than about order.
(
    id: "asterian_grammar_svo",
    name: "Asterian (grammar, head-initial)",
    lineage_depth_years: 0,
    seed: 42,

    phonemes: [
        // --- Stops ---
        (id: "ph_p", ipa: "p", kind: consonant, frequency_weight: 30,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "+labial", "-coronal", "-dorsal", "-round"]),
        (id: "ph_t", ipa: "t", kind: consonant, frequency_weight: 50,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "+coronal", "-dorsal"]),
        (id: "ph_k", ipa: "k", kind: consonant, frequency_weight: 45,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "-continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "+back", "-round"]),

        // --- Nasals ---
        (id: "ph_m", ipa: "m", kind: consonant, frequency_weight: 35,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "-continuant", "+nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "-dorsal", "-round"]),
        (id: "ph_n", ipa: "n", kind: consonant, frequency_weight: 40,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "-continuant", "+nasal", "-lateral", "-trill", "+voice", "-labial", "+coronal", "-dorsal"]),

        // --- Fricative ---
        (id: "ph_s", ipa: "s", kind: consonant, frequency_weight: 35,
         features: ["-syllabic", "+consonantal", "-sonorant", "-approximant", "+continuant", "-nasal", "-lateral", "-trill", "-voice", "-labial", "+coronal", "-dorsal"]),

        // --- Liquids ---
        (id: "ph_l", ipa: "l", kind: consonant, frequency_weight: 30,
         features: ["-syllabic", "+consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "+lateral", "-trill", "+voice", "-labial", "+coronal", "-dorsal"]),
        (id: "ph_r", ipa: "r", kind: consonant, frequency_weight: 25,
         features: ["-syllabic", "+consonantal", "+sonorant", "-approximant", "+continuant", "-nasal", "-lateral", "+trill", "+voice", "-labial", "+coronal", "-dorsal"]),

        // --- Glides ---
        (id: "ph_w", ipa: "w", kind: consonant, frequency_weight: 20,
         features: ["-syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "+high", "-low", "+back", "+round"]),
        (id: "ph_j", ipa: "j", romanization: "y", kind: consonant, frequency_weight: 10,
         features: ["-syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "-back", "-round"]),

        // --- Vowels ---
        (id: "ph_a", ipa: "a", kind: vowel, frequency_weight: 60,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "-high", "+low", "+back", "-round"]),
        (id: "ph_e", ipa: "e", kind: vowel, frequency_weight: 35,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "-high", "-low", "-back", "-round"]),
        (id: "ph_i", ipa: "i", kind: vowel, frequency_weight: 40,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "-labial", "-coronal", "+dorsal", "+high", "-low", "-back", "-round"]),
        (id: "ph_o", ipa: "o", kind: vowel, frequency_weight: 30,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "-high", "-low", "+back", "+round"]),
        (id: "ph_u", ipa: "u", kind: vowel, frequency_weight: 35,
         features: ["+syllabic", "-consonantal", "+sonorant", "+approximant", "+continuant", "-nasal", "-lateral", "-trill", "+voice", "+labial", "-coronal", "+dorsal", "+high", "-low", "+back", "+round"]),
    ],

    phonotactics: (
        templates: [
            (pattern: "CV",  weight: 45),
            (pattern: "CVC", weight: 35),
            (pattern: "V",   weight: 12),
            (pattern: "VC",  weight: 8),
        ],
        syllables_per_root: [
            (count: 1, weight: 25),
            (count: 2, weight: 55),
            (count: 3, weight: 20),
        ],
    ),

    prosody: (stress: fixed(from: left, offset: 0)),

    // The nominative-accusative case pair, to match this language's alignment.
    morphology: (
        morphemes: [
            (id: "m_nom", role: suffix, gloss: "NOM", form: (syllables: [
                (pattern: "V", segments: ["ph_u"]),
            ])),
            (id: "m_acc", role: suffix, gloss: "ACC", form: (syllables: [
                (pattern: "CV", segments: ["ph_t", "ph_a"]),
            ])),
        ],
    ),

    // Head-initial throughout, and harmonically so: `stemma grammar` reports no
    // disharmony for this one either. The pair differs in grammar, not in quality.
    syntax: (
        note: "Verb-medial and head-initial, with a nominative-accusative case system.",

        word_order: svo,
        adpositions: prepositions,
        genitive: noun_genitive,
        adjective: adjective_noun,

        alignment: nominative_accusative,
        relative_clause: postnominal,

        negation: particle,
        question: intonation,
        pro_drop: no,
        evidentiality: none,
        switch_reference: none,
    ),

    notes: [
        "The M18 acceptance fixture (head-initial half). Same phonology and seed as grammar_asterian.ron; only the grammar differs.",
    ],
)
